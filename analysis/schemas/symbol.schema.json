{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "symbol",
    "path",
    "line_start"
  ],
  "properties": {
    "symbol": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    }
  }
}
