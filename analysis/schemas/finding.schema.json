{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "type",
    "path",
    "description",
    "confidence"
  ],
  "properties": {
    "type": {
      "enum": [
        "entity_candidate",
        "symbol",
        "relationship",
        "dependency",
        "license",
        "security",
        "file_classification",
        "context"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Repository-relative POSIX path, runtime validator rejects traversal/absolute paths."
    },
    "description": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    },
    "symbol": {
      "type": "string"
    }
  }
}
